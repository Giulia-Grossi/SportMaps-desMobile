{
  "name": "sportmaps", "private": true, "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --prefix backend run build",
    "build:web": "npm --prefix frontend run build"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
